# SOLO DOCUMENTACIÓN: NO GUARDAR ESTE ARCHIVO CON VALORES REALES EN GITHUB.
# En PowerShell usa $env:WIX_SITE_ID='...' y $env:WIX_API_KEY='...'.
WIX_SITE_ID=ID_DEL_SITIO_WIX
WIX_API_KEY=CLAVE_WIX_CON_PERMISOS_MANAGE_DATA_COLLECTIONS

# OPCIONAL: configuración del servidor local (usa variables de entorno; no subas valores reales).
ABOIZ_ADMIN_PASSWORD=CONTRASENA_LOCAL_JOSEBA_DE_16_O_MAS
ABOIZ_DAVID_PASSWORD=CONTRASENA_LOCAL_DAVID_DE_16_O_MAS
PORT=4173
